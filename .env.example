# Copy to .dev.vars for Cloudflare, or .env.local for Next.js/Turso. Never commit real values.
APP_ORIGIN=http://127.0.0.1:5173
BOOTSTRAP_EMAIL=admin@campusbookstore.com
BOOTSTRAP_PASSWORD=
BOOTSTRAP_TOKEN=
# Optional HTTPS OCR adapter: raw image/PDF in, conservative JSON amount extraction out.
OCR_API_URL=
OCR_API_KEY=
# Vercel / native Next.js only. In production set APP_ORIGIN to your HTTPS website URL.
# Turso integration provides these after connecting the database to the Vercel project.
TURSO_AUTH_TOKEN=
TURSO_DATABASE_URL=
# Connect a PRIVATE Vercel Blob store; its integration provides this secret.
BLOB_READ_WRITE_TOKEN=
# Cloudflare uses DB / BUCKET bindings instead of the Turso/Blob variables above.
# Password sessions use cryptographically random opaque tokens, stored only as hashes.
# No signing secret or JWT is needed. No SMTP or WhatsApp API is required for click-to-chat.
